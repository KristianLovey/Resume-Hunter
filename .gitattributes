# Normaliziraj završetke redaka da Windows i alati ne rade lažne diffove.
# U repozitoriju je uvijek LF; radna kopija se također checkoutira kao LF.
* text=auto eol=lf

# Binarni sadržaj se ne dira.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
